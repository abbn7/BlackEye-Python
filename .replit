modules = ["web", "php-8.2", "nodejs-20", "python-3.12"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Run BlackEye"

[[workflows.workflow]]
name = "Run BlackEye"
author = 44171727
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
